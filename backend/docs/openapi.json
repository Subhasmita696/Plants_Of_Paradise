{
  "openapi": "3.0.0",
  "info": {
    "title": "Paradise Plants API",
    "description": "Microservices API for Paradise Plants E-commerce Platform",
    "version": "1.0.0",
    "contact": {
      "name": "Paradise Plants Support",
      "email": "support@paradiseplants.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "Catalog Service (Local)"
    },
    {
      "url": "http://localhost:3002",
      "description": "Inventory Service (Local)"
    },
    {
      "url": "http://localhost:3003",
      "description": "Orders Service (Local)"
    },
    {
      "url": "http://localhost:3004",
      "description": "Care Reminders Service (Local)"
    }
  ],
  "paths": {
    "/api/plants": {
      "get": {
        "tags": ["Catalog"],
        "summary": "Get all plants",
        "responses": {
          "200": {
            "description": "List of all plants",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Plant"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Catalog"],
        "summary": "Create a new plant",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlantInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Plant created successfully"
          }
        }
      }
    },
    "/api/plants/{id}": {
      "get": {
        "tags": ["Catalog"],
        "summary": "Get a specific plant",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Plant details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Plant"
                }
              }
            }
          },
          "404": {
            "description": "Plant not found"
          }
        }
      }
    },
    "/api/plants/category/{category}": {
      "get": {
        "tags": ["Catalog"],
        "summary": "Get plants by category",
        "parameters": [
          {
            "name": "category",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Plants in category",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Plant"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/inventory": {
      "get": {
        "tags": ["Inventory"],
        "summary": "Get all inventory",
        "responses": {
          "200": {
            "description": "All inventory records",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Inventory"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/inventory/{plantId}": {
      "get": {
        "tags": ["Inventory"],
        "summary": "Get inventory for a plant",
        "parameters": [
          {
            "name": "plantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Inventory details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Inventory"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": ["Inventory"],
        "summary": "Update inventory quantity",
        "parameters": [
          {
            "name": "plantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "quantity_in_stock": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Inventory updated"
          }
        }
      }
    },
    "/api/inventory/low-stock": {
      "get": {
        "tags": ["Inventory"],
        "summary": "Get low stock items",
        "responses": {
          "200": {
            "description": "Items below reorder level"
          }
        }
      }
    },
    "/api/orders": {
      "get": {
        "tags": ["Orders"],
        "summary": "Get all orders",
        "responses": {
          "200": {
            "description": "All orders",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Order"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Orders"],
        "summary": "Create a new order",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Order created"
          }
        }
      }
    },
    "/api/orders/{id}": {
      "get": {
        "tags": ["Orders"],
        "summary": "Get order details",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order with items"
          }
        }
      }
    },
    "/api/care-reminders": {
      "get": {
        "tags": ["Care Reminders"],
        "summary": "Get all care reminders",
        "responses": {
          "200": {
            "description": "All reminders"
          }
        }
      },
      "post": {
        "tags": ["Care Reminders"],
        "summary": "Create a new reminder",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReminderInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Reminder created"
          }
        }
      }
    },
    "/api/care-reminders/upcoming": {
      "get": {
        "tags": ["Care Reminders"],
        "summary": "Get upcoming reminders (7 days)",
        "responses": {
          "200": {
            "description": "Upcoming reminders"
          }
        }
      }
    },
    "/api/care-reminders/{id}/complete": {
      "patch": {
        "tags": ["Care Reminders"],
        "summary": "Mark reminder as completed",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Reminder completed"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Plant": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "scientific_name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "format": "decimal"
          },
          "category": {
            "type": "string"
          },
          "light_requirements": {
            "type": "string"
          },
          "water_frequency": {
            "type": "string"
          },
          "humidity_level": {
            "type": "string"
          },
          "image_url": {
            "type": "string"
          }
        }
      },
      "PlantInput": {
        "type": "object",
        "required": ["name", "price"],
        "properties": {
          "name": {
            "type": "string"
          },
          "scientific_name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "category": {
            "type": "string"
          },
          "light_requirements": {
            "type": "string"
          },
          "water_frequency": {
            "type": "string"
          },
          "humidity_level": {
            "type": "string"
          },
          "image_url": {
            "type": "string"
          }
        }
      },
      "Inventory": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "plant_id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "quantity_in_stock": {
            "type": "integer"
          },
          "reorder_level": {
            "type": "integer"
          },
          "supplier": {
            "type": "string"
          }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "order_number": {
            "type": "string"
          },
          "customer_name": {
            "type": "string"
          },
          "customer_email": {
            "type": "string"
          },
          "total_amount": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "confirmed", "shipped", "delivered", "cancelled"]
          },
          "items": {
            "type": "array"
          }
        }
      },
      "OrderInput": {
        "type": "object",
        "required": ["customer_name", "items"],
        "properties": {
          "customer_name": {
            "type": "string"
          },
          "customer_email": {
            "type": "string"
          },
          "customer_phone": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "plant_id": {
                  "type": "integer"
                },
                "quantity": {
                  "type": "integer"
                },
                "unit_price": {
                  "type": "number"
                }
              }
            }
          }
        }
      },
      "ReminderInput": {
        "type": "object",
        "required": ["plant_id", "reminder_type"],
        "properties": {
          "plant_id": {
            "type": "integer"
          },
          "reminder_type": {
            "type": "string",
            "enum": ["watering", "fertilizing", "pruning", "repotting", "inspection"]
          },
          "frequency": {
            "type": "string"
          },
          "next_due_date": {
            "type": "string",
            "format": "date"
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}
